<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Merch Studio & Catálogo Exclusivo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f6f7f9',
              100: '#eceff2',
              500: '#111827',
              600: '#0b0f19',
              accent: '#ff5e3a',
              accentHover: '#e04a27',
              gold: '#d4af37'
            }
          }
        }
      }
    }
  </script>
  <style>
    .glass-nav {
      backdrop-filter: blur(12px);
      background-color: rgba(255, 255, 255, 0.85);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .badge-glow {
      box-shadow: 0 0 15px rgba(255, 94, 58, 0.25);
    }
  </style>
</head>
<body class="bg-neutral-50 text-neutral-900 font-sans antialiased selection:bg-neutral-900 selection:text-white">

  <header class="sticky top-0 z-40 border-b border-neutral-200/80 glass-nav transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo & Master Wordmark Lockup -->
      <div class="flex items-center gap-4">
        <div id="brandLockup" class="flex items-center gap-3.5 cursor-pointer group select-none" onclick="window.scrollTo({top:0, behavior:'smooth'})">
          
          <!-- Optimized Logo Container with adaptive clean backdrop & border -->
          <div id="logoWrapper" class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-neutral-200/90 shadow-sm p-1.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-neutral-900 group-hover:shadow-md">
            <!-- Direct image display -->
            <img 
              id="mainBrandLogo" 
              src="https://i.postimg.cc/r0R8ScxD/logo.png" 
              alt="Logo Primordial" 
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
              onerror="handleLogoError(this)" 
            />
            <!-- Geometric Monogram Fallback if image link is restricted -->
            <div id="fallbackLogoBadge" class="hidden absolute inset-0 bg-neutral-950 text-white font-black text-lg flex items-center justify-center tracking-tighter">
              PR
            </div>
          </div>

          <!-- Master Typographic Brand Name + Integrated Tagline -->
          <div class="flex flex-col justify-center">
            <div class="flex items-center gap-2">
              <span id="brandNameDisplay" class="text-lg sm:text-xl font-black tracking-[0.2em] uppercase text-neutral-950 leading-none">
                PRIMORDIAL
              </span>
              <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-wider bg-neutral-900 text-white leading-none">
                STUDIO
              </span>
            </div>
            <div class="flex items-center mt-1">
              <span class="text-[10px] sm:text-[11px] font-bold tracking-[0.18em] text-neutral-500 uppercase">
                Merch & Apparel Atelier
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-neutral-600">
        <button onclick="switchCatalogSection('merch')" class="nav-tab active-nav-tab hover:text-neutral-900 transition-colors" id="nav-btn-merch">Catálogo Merch</button>
        <button onclick="switchCatalogSection('posm')" class="nav-tab hover:text-neutral-900 transition-colors" id="nav-btn-posm">Material POSM / POP</button>
        <a href="#tecnicas" class="hover:text-neutral-900 transition-colors">Técnicas</a>
        <a href="#clientes" class="hover:text-neutral-900 transition-colors">Clientes</a>
        <a href="#cotizador" class="hover:text-neutral-900 transition-colors">Cotizador</a>
      </nav>

      <!-- CTA & WhatsApp button (Uniform Height, Padding, & Spacing) -->
      <div class="flex items-center gap-3">
        <a 
          href="#cotizador" 
          class="hidden sm:inline-flex items-center justify-center h-11 px-5 rounded-full text-xs font-bold uppercase tracking-wider bg-neutral-950 hover:bg-neutral-800 text-white transition-all shadow-sm hover:shadow whitespace-nowrap"
        >
          Solicitar Muestra
        </a>
        <button 
          onclick="scrollToCotizador()" 
          class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500 hover:bg-emerald-600 text-white transition-all shadow-sm hover:shadow whitespace-nowrap"
        >
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
          <span>Cotizar WhatsApp</span>
        </button>
      </div>
    </div>
  </header>

  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-neutral-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 flex flex-col items-start space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-100 text-neutral-800 text-xs font-bold uppercase tracking-wider border border-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Catálogo & Producción Premium 2026
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-950 leading-[1.08]">
            Merchandising que la gente <span class="underline decoration-neutral-300 decoration-4 underline-offset-8">realmente quiere usar</span>.
          </h1>

          <p class="text-lg text-neutral-600 max-w-xl leading-relaxed">
            Diseñamos, producimos y personalizamos prendas y artículos de alta gama para empresas líderes, marcas de creadores y eventos. Olvídate del merch genérico: entregamos calidad de retail.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href="#catalogo" class="px-7 py-3.5 rounded-xl bg-neutral-950 hover:bg-neutral-800 text-white font-semibold text-sm transition shadow-lg flex items-center gap-2">
              Explorar Catálogo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="#clientes" class="px-6 py-3.5 rounded-xl bg-neutral-100 hover:bg-neutral-200 text-neutral-900 font-semibold text-sm transition border border-neutral-200">
              Ver Clientes & Casos
            </a>
          </div>

          <!-- Quick Metrics -->
          <div class="grid grid-cols-3 gap-6 pt-6 border-t border-neutral-100 w-full">
            <div>
              <p class="text-2xl font-black text-neutral-950">+50.000</p>
              <p class="text-xs text-neutral-500 font-medium">Prendas producidas</p>
            </div>
            <div>
              <p class="text-2xl font-black text-neutral-950">100%</p>
              <p class="text-xs text-neutral-500 font-medium">Garantía de calidad</p>
            </div>
            <div>
              <p class="text-2xl font-black text-neutral-950">7-12 días</p>
              <p class="text-xs text-neutral-500 font-medium">Tiempos récord</p>
            </div>
          </div>
        </div>

        <!-- Visual Hero Showcase Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto rounded-3xl overflow-hidden bg-gradient-to-tr from-neutral-950 via-neutral-900 to-neutral-800 p-6 sm:p-7 text-white shadow-2xl border border-neutral-800">
            <div class="absolute -top-12 -right-12 w-48 h-48 bg-neutral-700/30 rounded-full blur-3xl"></div>
            
            <div class="flex justify-between items-start mb-5 relative z-10">
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-neutral-200 border border-white/10">Colección Destacada</span>
              <span class="text-xs font-semibold text-neutral-400">Heavyweight 320 GSM</span>
            </div>

            <!-- Merch Real Photo Card -->
            <div class="relative group rounded-2xl overflow-hidden border border-neutral-700/80 shadow-2xl bg-neutral-900">
              <div class="w-full h-64 sm:h-72 overflow-hidden relative">
                <img 
                  src="https://i.postimg.cc/9FwhtQZn/442cad80-6402-42bc-897c-6545e16f7903.jpg" 
                  alt="Hoodie Cuello Redondo" 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='https://i.postimg.cc/sXbnVsxY/IMG-9265.jpg';"
                />
                <!-- Subtle Gradient Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent"></div>
                
                <!-- Bottom Tag on image -->
                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-[11px] font-bold text-white border border-white/15">
                    Algodón Perchado 320g
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-emerald-500/90 backdrop-blur-md text-[11px] font-black text-white">
                    Premium Fit
                  </span>
                </div>
              </div>

              <!-- Product Info bar under image -->
              <div class="p-4 bg-neutral-900/95 border-t border-neutral-800">
                <p class="text-base font-black text-white uppercase tracking-wider">Hoodie Cuello Redondo</p>
                <p class="text-xs text-neutral-400 mt-0.5">Bordado en alta densidad + DTF textil suave</p>
              </div>
            </div>

            <div class="mt-5 pt-4 border-t border-neutral-800 flex items-center justify-between text-xs relative z-10">
              <div>
                <p class="text-neutral-400">Mínimo de orden:</p>
                <p class="font-bold text-white text-sm">Desde 15 unidades</p>
              </div>
              <button onclick="openModalById('buso-hoodie-unisex')" class="px-4 py-2 rounded-lg bg-white text-neutral-900 font-bold hover:bg-neutral-100 transition text-xs shadow">
                Ver Ficha Técnica
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="clientes" class="py-14 bg-neutral-100/70 border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-xs uppercase font-extrabold tracking-widest text-neutral-400">Marcas y Colaboraciones</h2>
        <p class="text-xl font-bold text-neutral-900 mt-1">Empresas y creadores que visten nuestro merch</p>
      </div>

      <!-- Clients Logos Grid / Customized with real brand clients -->
      <div id="clientsContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <!-- Client slot 1: Spotify -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-tight text-neutral-950 uppercase group-hover:text-emerald-600 transition-colors">Spotify</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Custom Apparel & Kits</span>
        </div>

        <!-- Client slot 2: DAVID -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-[0.15em] text-neutral-950 uppercase group-hover:text-neutral-900 transition-colors">DAVID</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Agency Merch</span>
        </div>

        <!-- Client slot 3: Crimson Lab -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-tight text-neutral-950 uppercase group-hover:text-rose-600 transition-colors">Crimson Lab</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Streetwear & Staff</span>
        </div>

        <!-- Client slot 4: El Tachi Bar -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-tight text-neutral-950 uppercase group-hover:text-amber-600 transition-colors">El Tachi Bar</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Hospitality & Delantales</span>
        </div>

        <!-- Client slot 5: Burguerville -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-tight text-neutral-950 uppercase group-hover:text-orange-600 transition-colors">Burguerville</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Gastro Merch & Gorras</span>
        </div>

        <!-- Client slot 6: Juan Burgers -->
        <div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm flex flex-col items-center justify-center text-center group hover:border-neutral-900 hover:shadow-md transition-all duration-300">
          <span class="text-sm font-black tracking-tight text-neutral-950 uppercase group-hover:text-neutral-950 transition-colors">Juan Burgers</span>
          <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider mt-1">Dotación & Streetwear</span>
        </div>
      </div>
    </div>
  </section>

  <section id="catalogo" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Primary Section Selector (Merch vs POSM / POP) -->
      <div class="mb-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 border-b border-neutral-200 pb-8">
        <div>
          <span class="text-xs uppercase font-extrabold tracking-widest text-neutral-400">Colecciones & Producción 2026</span>
          <h2 id="catalogMainTitle" class="text-3xl sm:text-4xl font-black text-neutral-950 mt-1">Catálogo de Merch</h2>
          <p id="catalogMainSubtitle" class="text-sm text-neutral-500 mt-1">Especificaciones técnicas y valores unitarios de referencia (RFP Visibility Andina 2026).</p>
        </div>

        <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-neutral-100 border border-neutral-200 max-w-full overflow-x-auto">
          <button id="tabMerchBtn" onclick="switchCatalogSection('merch')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition shadow-sm bg-neutral-950 text-white">
            Prendas & Merch
          </button>
          <button id="tabPosmBtn" onclick="switchCatalogSection('posm')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900">
            Material POSM / POP
          </button>
          <button id="tabPremiumBtn" onclick="switchCatalogSection('premium')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900">
            Regalos Ejecutivos
          </button>
          <button id="tabSostenibleBtn" onclick="switchCatalogSection('sostenible')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900">
            Sostenible (Eco)
          </button>
          <button id="tabEventosBtn" onclick="switchCatalogSection('eventos')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900">
            Eventos
          </button>
          <button id="tabBienestarBtn" onclick="switchCatalogSection('bienestar')" class="cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900">
            Bienestar
          </button>
        </div>
      </div>

      <!-- Filter Buttons Sub-bar -->
      <div id="subFilterContainer" class="flex flex-wrap gap-2 mb-8">
        <button onclick="filterCatalog('all')" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition bg-neutral-900 text-white" data-category="all">Todos los artículos</button>
        <button onclick="filterCatalog('apparel')" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition text-neutral-600 hover:text-neutral-900" data-category="apparel">Textil & Hoodies</button>
        <button onclick="filterCatalog('caps')" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition text-neutral-600 hover:text-neutral-900" data-category="caps">Gorras & Accesorios</button>
      </div>

      <!-- Catalog Grid -->
      <div id="catalogGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Products will be rendered dynamically by JavaScript -->
      </div>

    </div>
  </section>

  <section id="tecnicas" class="py-20 bg-neutral-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-extrabold tracking-widest text-neutral-400">Acabados Industriales</span>
        <h2 class="text-3xl sm:text-4xl font-black mt-2">Técnicas de Personalización</h2>
        <p class="text-sm text-neutral-400 mt-2">Asesoramos cada diseño para elegir la técnica con mejor durabilidad y fidelidad a tu identidad gráfica.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <!-- Technique 1 -->
        <div class="p-6 rounded-2xl bg-neutral-800/80 border border-neutral-700/80 hover:border-neutral-500 transition">
          <div class="w-10 h-10 rounded-xl bg-neutral-700 flex items-center justify-center font-bold text-sm mb-4">01</div>
          <h3 class="text-lg font-bold mb-2">Bordado de Alta Densidad</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">Ideal para hoodies pesados, gorras structured y chaquetas. Relieve premium y durabilidad eterna lavado tras lavado.</p>
        </div>

        <!-- Technique 2 -->
        <div class="p-6 rounded-2xl bg-neutral-800/80 border border-neutral-700/80 hover:border-neutral-500 transition">
          <div class="w-10 h-10 rounded-xl bg-neutral-700 flex items-center justify-center font-bold text-sm mb-4">02</div>
          <h3 class="text-lg font-bold mb-2">DTF Textil Ultra Soft</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">Permite degradados, millones de colores y detalles hiperfinos sin textura plástica acartonada. Gran elasticidad.</p>
        </div>

        <!-- Technique 3 -->
        <div class="p-6 rounded-2xl bg-neutral-800/80 border border-neutral-700/80 hover:border-neutral-500 transition">
          <div class="w-10 h-10 rounded-xl bg-neutral-700 flex items-center justify-center font-bold text-sm mb-4">03</div>
          <h3 class="text-lg font-bold mb-2">Serigrafía al Tacto Cero</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">Tintas al agua y descarga que se integran en el hilo del algodón. Estilo streetwear clásico con sensación ligera.</p>
        </div>

        <!-- Technique 4 -->
        <div class="p-6 rounded-2xl bg-neutral-800/80 border border-neutral-700/80 hover:border-neutral-500 transition">
          <div class="w-10 h-10 rounded-xl bg-neutral-700 flex items-center justify-center font-bold text-sm mb-4">04</div>
          <h3 class="text-lg font-bold mb-2">Grabado Láser de Precisión</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">Aplicado en botellas de acero inoxidable, libretas de cuero y termo mugs. No se borra ni se desgasta con el uso rudo.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="cotizador" class="py-20 bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl border border-neutral-200">
        <div class="text-center max-w-lg mx-auto mb-10">
          <span class="text-xs uppercase font-extrabold tracking-widest text-neutral-400">Calculadora Rápida</span>
          <h2 class="text-3xl font-black text-neutral-950 mt-1">Arma tu Estimado de Merch</h2>
          <p class="text-xs text-neutral-500 mt-2">Selecciona lo que tienes en mente y envíanos el desglose listo por WhatsApp o Correo.</p>
        </div>

        <form id="quoteForm" onsubmit="handleQuoteSubmit(event)" class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Product selection -->
            <div>
              <label class="block text-xs font-bold uppercase text-neutral-700 mb-2">Producto Principal</label>
              <select id="quoteProduct" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-neutral-900 focus:outline-none font-medium">
                <option value="Camiseta Algodón 180g">Camiseta Algodón 180g ($45.000 COP)</option>
                <option value="Buso Hoodie Unisex 320g" selected>Buso Hoodie Unisex 320g ($98.000 COP)</option>
                <option value="Gorra Gabardina Drill">Gorra Gabardina Drill ($38.000 COP)</option>
              </select>
            </div>

            <!-- Quantity -->
            <div>
              <label class="block text-xs font-bold uppercase text-neutral-700 mb-2">Cantidad Estimada</label>
              <select id="quoteQuantity" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-neutral-900 focus:outline-none font-medium">
                <option value="15 a 30 unidades">15 a 30 unidades (Muestreo / Equipo chico)</option>
                <option value="50 a 100 unidades" selected>50 a 100 unidades (Lanzamiento / Evento)</option>
                <option value="150 a 300 unidades">150 a 300 unidades (Producción Mediana)</option>
                <option value="+500 unidades">+500 unidades (Volumen Corporativo)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Technique -->
            <div>
              <label class="block text-xs font-bold uppercase text-neutral-700 mb-2">Técnica Preferida</label>

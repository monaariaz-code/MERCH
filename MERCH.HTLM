    // Dynamic section switcher for all categories
    function switchCatalogSection(sectionKey) {
      currentCatalogSection = sectionKey;
      const config = categoryMap[sectionKey];
      if (!config) return;

      const titleEl = document.getElementById('catalogMainTitle');
      const subtitleEl = document.getElementById('catalogMainSubtitle');
      const subFilter = document.getElementById('subFilterContainer');
      const quoteSelect = document.getElementById('quoteProduct');

      // Update titles
      if (titleEl) titleEl.textContent = config.title;
      if (subtitleEl) subtitleEl.textContent = config.subtitle;

      // Update pill buttons visual states
      document.querySelectorAll('.cat-pill-btn').forEach(btn => {
        btn.className = 'cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition text-neutral-600 hover:text-neutral-900';
      });
      const activeBtnId = {
        merch: 'tabMerchBtn',
        posm: 'tabPosmBtn',
        premium: 'tabPremiumBtn',
        sostenible: 'tabSostenibleBtn',
        eventos: 'tabEventosBtn',
        bienestar: 'tabBienestarBtn'
      }[sectionKey];
      if (activeBtnId && document.getElementById(activeBtnId)) {
        document.getElementById(activeBtnId).className = 'cat-pill-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition shadow-sm bg-neutral-950 text-white';
      }

      // Update nav link indicators
      document.querySelectorAll('.nav-tab').forEach(t => {
        t.className = 'nav-tab hover:text-neutral-900 transition-colors';
      });
      const navBtn = document.getElementById(`nav-btn-${sectionKey}`);
      if (navBtn) {
        navBtn.className = 'nav-tab text-neutral-950 font-bold transition-colors border-b-2 border-neutral-900 pb-1';
      }

      // Render subfilters
      if (subFilter) {
        subFilter.innerHTML = config.subfilters.map((sf, idx) => `
          <button onclick="filterCatalog('${sf.key}')" class="filter-btn px-4 py-2 rounded-lg text-xs font-bold transition ${idx === 0 ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-900'}" data-category="${sf.key}">
            ${sf.label}
          </button>
        `).join('');
      }

      // Populate quote form options
      if (quoteSelect) {
        quoteSelect.innerHTML = '';
        config.data.forEach(p => {
          const opt = document.createElement('option');
          opt.value = p.title;
          opt.textContent = `${p.title} (${p.priceValue})`;
          quoteSelect.appendChild(opt);
        });
      }

      renderCatalog(config.data);
    }

    // Function to render product cards matching the slide's card design
    function renderCatalog(items) {
      const grid = document.getElementById('catalogGrid');
      grid.innerHTML = '';

      items.forEach(product => {
        const card = document.createElement('div');
        card.className = 'group bg-white rounded-3xl border border-neutral-200/90 overflow-hidden flex flex-col p-5 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1';
        
        card.innerHTML = `
          <!-- Top Category Tag Pill (Identical to slide) -->
          <div class="mb-3.5">
            <span class="inline-block w-full py-1.5 px-3 rounded-lg bg-blue-50/80 border border-blue-100/80 text-[11px] font-bold text-blue-700 tracking-wider">
              ${product.itemCode}
            </span>
          </div>

          <!-- Product Image Container -->
          <div class="relative w-full h-64 rounded-2xl overflow-hidden bg-neutral-100 mb-5 border border-neutral-100">
            <img 
              src="${product.image}" 
              alt="${product.title}" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80';"
            />
          </div>

          <!-- Product Typography & Details -->
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-extrabold text-xl text-neutral-900 mb-1 leading-snug tracking-tight">
                ${product.title}
              </h3>
              
              <!-- Price Badge -->
              <div class="flex items-baseline gap-1.5 mb-3.5">
                <span class="text-xl font-black text-emerald-600 tracking-tight">${product.priceValue}</span>
                <span class="text-xs font-semibold text-neutral-400 uppercase">${product.taxNote}</span>
              </div>

              <!-- Technical Specs (From Slide) -->
              <div class="space-y-1.5 text-xs text-neutral-600 mb-4 bg-neutral-50/80 p-3.5 rounded-xl border border-neutral-100">
                <p><strong class="font-bold text-neutral-900">Especificación:</strong> ${product.especificacion}</p>
                <p><strong class="font-bold text-neutral-900">Medidas:</strong> ${product.medidas}</p>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="pt-2 flex items-center gap-2">
              <button 
                onclick="openModalById('${product.id}')" 
                class="flex-1 py-2.5 px-3 rounded-xl text-xs font-bold border border-neutral-200 text-neutral-700 hover:bg-neutral-100 transition text-center"
              >
                Ficha Técnica
              </button>
              <button 
                onclick="prefillQuote('${product.title}')" 
                class="flex-1 py-2.5 px-3 rounded-xl text-xs font-bold bg-neutral-950 text-white hover:bg-neutral-800 transition text-center"
              >
                Cotizar
              </button>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    // Filter catalog items
    function filterCatalog(category) {
      document.querySelectorAll('.filter-btn').forEach(btn => {
        if (btn.dataset.category === category) {
          btn.className = 'filter-btn px-4 py-2 rounded-lg text-xs font-bold transition bg-neutral-900 text-white';
        } else {
          btn.className = 'filter-btn px-4 py-2 rounded-lg text-xs font-bold transition text-neutral-600 hover:text-neutral-900';
        }
      });

      const activeConfig = categoryMap[currentCatalogSection];
      if (!activeConfig) return;

      if (category === 'all') {
        renderCatalog(activeConfig.data);
      } else {
        const filtered = activeConfig.data.filter(p => p.category === category);
        renderCatalog(filtered);
      }
    }

    // Modal view handler updated with all category datasets
    function openModalById(id) {
      const allItems = [
        ...merchProducts, 
        ...posmProducts, 
        ...premiumProducts, 
        ...sostenibleProducts, 
        ...activacionesProducts, 
        ...bienestarProducts
      ];
      const product = allItems.find(p => p.id === id);
      if (!product) return;

      const modalContent = document.getElementById('modalContent');
      modalContent.innerHTML = `
        <div class="space-y-5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-100">
              ${product.itemCode}
            </span>
            <span class="text-xs text-neutral-400 font-medium">${product.minOrder}</span>
          </div>

          <div class="flex flex-col sm:flex-row gap-5 items-start">
            <div class="w-full sm:w-1/2 h-56 rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-200">
              <img 
                src="${product.image}" 
                alt="${product.title}" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80';"
              />
            </div>
            <div class="w-full sm:w-1/2 flex flex-col justify-center">
              <h3 class="text-2xl font-black text-neutral-950">${product.title}</h3>
              <div class="flex items-baseline gap-1.5 mt-1">
                <span class="text-2xl font-black text-emerald-600">${product.priceValue}</span>
                <span class="text-xs font-semibold text-neutral-400 uppercase">${product.taxNote}</span>
              </div>
              <p class="text-xs text-neutral-500 mt-2 leading-relaxed">${product.description}</p>
            </div>
          </div>

          <div class="bg-neutral-50 p-4 rounded-2xl border border-neutral-200 space-y-2 text-xs">
            <div><strong class="text-neutral-900">Especificación técnica:</strong> <span class="text-neutral-600">${product.especificacion}</span></div>
            <div><strong class="text-neutral-900">Medidas:</strong> <span class="text-neutral-600">${product.medidas}</span></div>
            <div><strong class="text-neutral-900">Acabados / Técnicas:</strong> <span class="text-neutral-600">${product.techniques.join(', ')}</span></div>
          </div>

          <div class="pt-4 border-t border-neutral-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs text-neutral-500">Muestras y prototipos disponibles</span>
            <button onclick="prefillQuote('${product.title}')" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white font-bold text-xs transition">
              Seleccionar y Cotizar
            </button>
          </div>
        </div>
      `;

      const modal = document.getElementById('productModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('productModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Scroll helpers
    function scrollToCotizador() {
      document.getElementById('cotizador').scrollIntoView({ behavior: 'smooth' });
    }

    function prefillQuote(productTitle) {
      closeModal();
      scrollToCotizador();
      const select = document.getElementById('quoteProduct');
      for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].text.toLowerCase().includes(productTitle.toLowerCase().split(' ')[0])) {
          select.selectedIndex = i;
          break;
        }
      }
      showToast(`Seleccionaste ${productTitle} para cotizar`);
    }

    // Handle form submit and prepare WhatsApp link
    function handleQuoteSubmit(e) {
      e.preventDefault();
      const product = document.getElementById('quoteProduct').value;
      const quantity = document.getElementById('quoteQuantity').value;
      const technique = document.getElementById('quoteTechnique').value;
      const timeline = document.getElementById('quoteTimeline').value;
      const notes = document.getElementById('quoteNotes').value || 'Sin notas adicionales';

      const message = `¡Hola! Me gustaría cotizar un proyecto de Merch:%0A%0A` +
        `• *Producto:* ${encodeURIComponent(product)}%0A` +
        `• *Cantidad:* ${encodeURIComponent(quantity)}%0A` +
        `• *Técnica de preferencia:* ${encodeURIComponent(technique)}%0A` +
        `• *Tiempo esperado:* ${encodeURIComponent(timeline)}%0A` +
        `• *Detalles:* ${encodeURIComponent(notes)}%0A%0A` +
        `¿Podríamos revisar muestras y cotización formal?`;

      // Simulating WhatsApp redirect (replace 573000000000 with your real phone)
      const waUrl = `https://wa.me/573000000000?text=${message}`;
      
      showToast('Generando enlace para WhatsApp...');
      setTimeout(() => {
        window.open(waUrl, '_blank');
      }, 500);
    }

    // Toast Notification helper
    function showToast(message) {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastMessage');
      text.innerText = message;
      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3500);
    }

    // Logo styling controls & modal handlers
    function openLogoCustomizer(event) {
      if (event) event.stopPropagation();
      const modal = document.getElementById('logoCustomizerModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeLogoCustomizer() {
      const modal = document.getElementById('logoCustomizerModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function setLogoTheme(theme) {
      const wrapper = document.getElementById('logoWrapper');
      const footerWrapper = document.getElementById('footerLogoWrapper');
      
      if (theme === 'white') {
        wrapper.className = 'relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white border border-neutral-200/90 shadow-sm p-1.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-neutral-900 group-hover:shadow-md';
        if (footerWrapper) footerWrapper.className = 'w-10 h-10 rounded-xl bg-white p-1 flex items-center justify-center border border-white/20 shadow overflow-hidden';
        showToast('Fondo blanco aplicado');
      } else if (theme === 'dark') {
        wrapper.className = 'relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-neutral-950 border border-neutral-800 shadow-sm p-1.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-neutral-500 group-hover:shadow-md';
        if (footerWrapper) footerWrapper.className = 'w-10 h-10 rounded-xl bg-neutral-900 p-1 flex items-center justify-center border border-neutral-800 shadow overflow-hidden';
        showToast('Fondo negro mate aplicado');
      } else if (theme === 'neutral') {
        wrapper.className = 'relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-neutral-100 border border-neutral-300/80 shadow-sm p-1.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-neutral-900 group-hover:shadow-md';
        if (footerWrapper) footerWrapper.className = 'w-10 h-10 rounded-xl bg-neutral-800 p-1 flex items-center justify-center border border-neutral-700 shadow overflow-hidden';
        showToast('Fondo gris aplicado');
      }
    }

    function applyLogoSettings() {
      const newUrl = document.getElementById('customLogoUrlInput').value.trim();
      if (newUrl) {
        const headerImg = document.getElementById('mainBrandLogo');
        const footerImg = document.getElementById('footerBrandLogo');
        if (headerImg) headerImg.src = newUrl;
        if (footerImg) footerImg.src = newUrl;
        showToast('Enlace de logo actualizado');
      }
      closeLogoCustomizer();
    }

    // Logo image error fallback handler
    function handleLogoError(imgEl) {
      // In case Postimages direct link uses a custom name or has hotlink restrictions,
      // fallback smoothly to emblem badge
      imgEl.style.display = 'none';
      const fallback = document.getElementById('fallbackLogoBadge');
      if (fallback) {
        fallback.classList.remove('hidden');
        fallback.classList.add('flex');
      }
    }

    // Initialize on window load
    window.addEventListener('DOMContentLoaded', () => {
      switchCatalogSection('merch');

      // Close modal on click outside
      window.addEventListener('click', (e) => {
        const modal = document.getElementById('productModal');
        if (e.target === modal) {
          closeModal();
        }
      });
    });
  </script>
</body>
</html>
